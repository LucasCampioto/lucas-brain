# Absolute path to lucas-brain repo root (folders 01-12). Default: parent of mcp/
LUCAS_BRAIN_ROOT=

# HTTP server
PORT=7337
HOST=127.0.0.1

# Required in production / when binding outside localhost
LUCAS_BRAIN_API_KEY=

# Comma-separated origins for CORS (optional)
CORS_ORIGIN=

# Enable file watcher hot-reload (default: true when NODE_ENV !== production)
WATCH=true
